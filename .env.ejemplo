# La Esquina del Cafe - configuracion local
# Copia este archivo como ".env" (en la misma carpeta) y ajusta los valores.
# Formato: CLAVE=valor  (sin espacios alrededor del signo igual y sin comillas).
# Las lineas que empiezan con # son comentarios. El archivo .env NO se sube a Git.
# Lo leen iniciar.bat (Windows). En Linux/macOS, iniciar.sh define DATABASE_URL solo;
# las demas variables se pueden exportar antes de correrlo (export HORA_RESPALDO=22:00).

# ---------------------------------------------------------------------------
# Base de datos (obligatoria en modo MySQL; "iniciar.bat sqlite" la ignora)
#   mysql+pymysql://USUARIO:CONTRASENA@HOST:PUERTO/NOMBRE_BASE
# La base se crea sola si no existe (el usuario necesita permiso para crearla;
# con root funciona). Si la contrasena tiene @ : / # o %, escribela codificada
# (@ = %40, : = %3A, / = %2F, # = %23, % = %25).
DATABASE_URL=mysql+pymysql://root:tu_contrasena@127.0.0.1:3306/la_esquina_del_cafe

# ---------------------------------------------------------------------------
# Clave para firmar las sesiones (token del login). Si no se define se usa una
# clave de desarrollo y aparece un aviso. Pon cualquier texto largo y secreto.
SECRET_KEY=cambia-esto-por-un-texto-largo-y-secreto

# Codigo maestro para "Olvide mi contrasena" en el login (por omision CAFE-MAESTRO-2026).
CODIGO_MAESTRO=CAFE-MAESTRO-2026

# ---------------------------------------------------------------------------
# Opcionales (quita el # para cambiarlas). Se muestran con su valor por omision.

# Zona horaria del negocio: define "hoy", los reportes por dia y la hora mostrada.
# TZ_NEGOCIO=America/Mexico_City

# Horas que dura la sesion antes de pedir login de nuevo.
# SESION_HORAS=12

# Hora del respaldo diario (HH:MM, hora del negocio). Si el equipo esta apagado a
# esa hora, el respaldo se hace al arrancar el sistema.
# HORA_RESPALDO=23:00

# Carpeta de la unidad externa (USB/disco) donde se copia cada respaldo, con
# retencion de 30 dias. LA CARPETA DEBE EXISTIR (no se crea sola). Sin comillas.
# Si no esta definida o la unidad no esta conectada, el respaldo queda solo en local.
# RUTA_RESPALDO_EXTERNO=E:\RespaldosCafe

# Puerto e interfaz del servidor (solo iniciar.bat; iniciar.sh usa PUERTO y 0.0.0.0).
# HOST=0.0.0.0 permite entrar desde otros equipos de la red (Windows pedira permiso del firewall).
# PUERTO=8000
# HOST=127.0.0.1
