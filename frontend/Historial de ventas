    <div class="velo" id="velo" hidden></div>

    <div class="contenido">
      <main class="principal">
        
<h1>Historial de ventas</h1>
<p class="subtitulo">Consulta cada transacción y da seguimiento a las ventas de tu cafetería.</p>

<section class="resumen-card" aria-label="Resumen del periodo">
  <div>
    <small>Ventas netas</small>
    <strong id="r-netas">—</strong>
    <span id="r-rango">&nbsp;</span>
  </div>
  <div>
    <small>Ventas completadas</small>
    <strong id="r-completadas">—</strong>
    <span id="r-ticket">&nbsp;</span>
  </div>
  <div>
    <small>Ventas canceladas</small>
    <strong id="r-canceladas">—</strong>
    <span id="r-excluidas">&nbsp;</span>
  </div>
</section>

<section class="panel" aria-label="Transacciones">
  <form class="panel-filtros" id="filtros" autocomplete="off">
    <div class="grupo">
      <span class="etq">Fecha inicial</span>
      <div class="campo-fecha">
        <button type="button" aria-label="Fecha inicial"><span data-texto>—</span><svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg></button>
        <input type="date" id="f-desde" tabindex="-1" aria-hidden="true">
      </div>
    </div>
    <div class="grupo">
      <span class="etq">Fecha final</span>
      <div class="campo-fecha">
        <button type="button" aria-label="Fecha final"><span data-texto>—</span><svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg></button>
        <input type="date" id="f-hasta" tabindex="-1" aria-hidden="true">
      </div>
    </div>
    <div class="grupo">
      <label class="etq" for="f-estado">Estado</label>
      <select id="f-estado">
        <option value="">Todos los estados</option>
        <option value="COMPLETADA">Completadas</option>
        <option value="CANCELADA">Canceladas</option>
      </select>
    </div>
    <button class="btn" type="submit"><svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 6h18M7 12h10M10 18h4"/></svg> Filtrar ventas</button>
  </form>

  <div class="panel-titulo">
    <h2>Transacciones</h2>
    <small id="t-conteo">Más recientes primero</small>
  </div>

  <div class="tabla-caja">
    <table>
      <thead>
        <tr><th>Folio</th><th>Fecha</th><th>Total</th><th>Forma de pago</th><th>Estado</th></tr>
      </thead>
      <tbody id="tabla-ventas">
        <tr><td colspan="5" class="vacio">Cargando…</td></tr>
      </tbody>
    </table>
  </div>

  <div class="panel-pie">
    <span id="pag-info">&nbsp;</span>
    <nav class="paginacion" id="paginacion" aria-label="Paginación"></nav>
  </div>
</section>

<dialog id="modal-venta" class="modal ancho">
  <h2 id="v-titulo">Ticket</h2>
  <div class="ticket-meta" id="v-meta"></div>
  <div class="tabla-caja">
    <table>
      <thead><tr><th>Producto</th><th class="num">Cant.</th><th class="num">Precio</th><th class="num">Subtotal</th></tr></thead>
      <tbody id="v-lineas"></tbody>
    </table>
  </div>
  <div class="totales" id="v-totales"></div>
  <p class="nota-pendiente" id="v-nota" hidden>
    La cancelación y devolución (regreso de stock a los lotes) se activará al integrar M1 de Francisco.
  </p>
  <div class="modal-pie">
    <button class="btn btn-peligro" type="button" id="v-cancelar" disabled
            title="Pendiente de integrar M1">Cancelar / devolver venta</button>
    <button class="btn btn-claro" type="button" id="v-cerrar">Cerrar</button>
  </div>
</dialog>

      </main>
      <footer class="pie">
        <span>grano. / Administración de cafetería</span>
        <span>Sucursal Centro · Importes en MXN</span>
      </footer>
    </div>
  </div>

  <div id="avisos" class="avisos" role="status" aria-live="polite"></div>

  <!-- TEMPORAL: sustituir por la pantalla de login del equipo cuando exista -->
  <dialog id="dlg-token" class="modal">
    <form method="dialog" id="form-token">
      <h2>Iniciar sesión (temporal)</h2>
      <p class="ayuda">Pega el token de administrador. Lo obtienes con
        <code>python -m app.dev_token</code>.</p>
      <textarea id="txt-token" rows="4" required spellcheck="false"></textarea>
      <div class="modal-pie">
        <button class="btn btn-claro" type="button" id="btn-token-cancelar">Cancelar</button>
        <button class="btn" type="submit">Guardar</button>
      </div>
    </form>
  </dialog>

  <script src="js/api.js"></script>
  
<script src="js/ventas.js"></script>

</body>
</html>
